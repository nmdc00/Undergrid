# Copy to an ignored local .env; never commit actual secrets.
UNDERGRID_ENVIRONMENT=development
UNDERGRID_ORIGIN=https://localhost:8443
UNDERGRID_LISTEN=127.0.0.1:8080
# API login must be a nonowner member of undergrid_app, not the migration role.
UNDERGRID_DATABASE_URL=
# Separate nonowner login with undergrid_worker membership.
UNDERGRID_WORKER_DATABASE_URL=
# Supply only to the separate migration command, not the API process.
UNDERGRID_MIGRATION_DATABASE_URL=
UNDERGRID_OIDC_ISSUER=
UNDERGRID_OIDC_CLIENT_ID=
UNDERGRID_OIDC_CLIENT_SECRET=
# Independent random 32-byte keys, base64 encoded. Persist across restarts.
UNDERGRID_SESSION_KEY=
UNDERGRID_CURSOR_KEY=
# Separate 32-byte network credential issuance key; no session/cursor reuse.
UNDERGRID_CREDENTIAL_ISSUANCE_KEY=
UNDERGRID_CREDENTIAL_ISSUANCE_KEY_ID=
# Required approved published terms version; no built-in legal defaults.
UNDERGRID_TERMS_VERSION=
# Internal report queue target only; not a published response-time promise.
UNDERGRID_REPORT_TRIAGE_WINDOW=72h
# JSON array of reviewed contribution templates; empty disables rights-dependent work.
# Test-only templates are rejected in production. Never supply fixture legal terms.
UNDERGRID_CONTRIBUTION_TEMPLATES_FILE=
