# Separate financial worker process only. Never load alongside owner API/network configuration.
# Worker-only nonowner login: no app/network role memberships or elevated privileges.
UNDERGRID_SANDBOX_DATABASE_URL=postgres://sandbox_worker:REPLACE@SANDBOX_DATABASE/undergrid_sandbox?sslmode=verify-full
UNDERGRID_SANDBOX_STRIPE_LISTEN=127.0.0.1:8082
# Approved test account/product/price must match the API's fixed TEST catalog exactly.
UNDERGRID_SANDBOX_STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_APPROVED_TEST_KEY
UNDERGRID_SANDBOX_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_SEPARATE_TEST_ENDPOINT_SECRET
UNDERGRID_SANDBOX_STRIPE_ACCOUNT_ID=acct_REPLACE_APPROVED_TEST_ACCOUNT
UNDERGRID_SANDBOX_STRIPE_PRODUCT=platform-test
UNDERGRID_SANDBOX_STRIPE_PRICE_ID=price_REPLACE_APPROVED_FIXED_ONE_TIME_PRICE
UNDERGRID_SANDBOX_STRIPE_PROVIDER_PRODUCT_ID=prod_REPLACE_APPROVED_TEST_PRODUCT
UNDERGRID_SANDBOX_STRIPE_SUCCESS_URL=https://sandbox.example.invalid/success
UNDERGRID_SANDBOX_STRIPE_CANCEL_URL=https://sandbox.example.invalid/cancel
# Optional bounded TEST renewal collection; leave absent until explicitly qualified.
# Uses owner-requested hosted payer setup and manually controlled invoices, never automatic subscriptions.
# UNDERGRID_SANDBOX_STRIPE_RENEWALS=manual_test_v1
