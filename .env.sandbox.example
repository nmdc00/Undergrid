# Separate sandbox host/config only; never load .env.example alongside this file.
# Provision app-only login: NO SUPERUSER, BYPASSRLS, table ownership, worker or network membership.
UNDERGRID_SANDBOX_DATABASE_URL=postgres://sandbox_api:REPLACE@SANDBOX_DATABASE/undergrid_sandbox?sslmode=verify-full
# Migration credential belongs only to the one-off migrate process, not API runtime.
UNDERGRID_SANDBOX_MIGRATION_DATABASE_URL=postgres://sandbox_migrator:REPLACE@SANDBOX_DATABASE/undergrid_sandbox?sslmode=verify-full
UNDERGRID_SANDBOX_LISTEN=127.0.0.1:8081
UNDERGRID_SANDBOX_ORIGIN=https://sandbox.example.invalid
UNDERGRID_SANDBOX_SESSION_KEY=REPLACE_WITH_SEPARATE_BASE64_32_BYTE_KEY
UNDERGRID_SANDBOX_OIDC_ISSUER=https://SANDBOX_IDENTITY_PROVIDER
UNDERGRID_SANDBOX_OIDC_CLIENT_ID=SEPARATE_SANDBOX_CLIENT_AUDIENCE
UNDERGRID_SANDBOX_OIDC_CLIENT_SECRET=REPLACE_WITH_SANDBOX_ONLY_SECRET
# Server-selected test product; owner/provider terms and account approvals still required.
UNDERGRID_SANDBOX_TEST_CATALOG={"platform-test":{"product":"platform-test","asset":"USD","amount_atomic":"500","fee_atomic":"0","payee":"REPLACE_TEST_ACCOUNT","rail":"stripe_test","test_terms_id":"REPLACE_APPROVED_TEST_TERMS","test_terms_hash":"REPLACE_WITH_64_HEX_SHA256"}}
